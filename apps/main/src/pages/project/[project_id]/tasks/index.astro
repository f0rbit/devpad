---
// v2.4 IA consolidation (task B1.4) — tasks + goals merged into the work
// outline. Redirects rather than deletes: bookmarks, external links, and
// in-flight PRs referencing the old URL keep working.
const project_id = Astro.params.project_id!;
return Astro.redirect(`/project/${project_id}/work${Astro.url.search}`, 301);
