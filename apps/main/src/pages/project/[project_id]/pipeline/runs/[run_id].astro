---
import type { PipelinePackage, RunStatus } from "@devpad/schema";
import DispatchStatusPanel from "@/components/solid/pipelines/dispatch-status";
import RollbackButton from "@/components/solid/pipelines/rollback-button";
import RunProgress from "@/components/solid/pipelines/run-progress";
import StageEventTimeline from "@/components/solid/pipelines/stage-event-timeline";
import StageGate from "@/components/solid/pipelines/stage-gate";
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { getProject, rethrow } from "@/utils/api-client";
import {
	github_commit_url,
	github_repo_from_url,
	github_workflow_url,
	parse_external_target,
	short_sha,
} from "@/utils/pipeline-external";

// @ts-expect-error rethrow is used in conditional return path
void rethrow;

const project_id = Astro.params.project_id!;
const run_id = Astro.params.run_id!;

const guard = await getProject(Astro);
if (guard instanceof Response) return guard;
const { client, project } = guard;

// Graceful degradation: when the orchestrator is unreachable (503 from the proxy)
// render the shell with a degraded banner instead of propagating the 5xx.
// Genuine not-found / not-owned stay 404.
const run_result = await client.pipelines.get(run_id);
const unreachable = !run_result.ok && run_result.error.status_code === 503;
if (!run_result.ok && !unreachable) return rethrow(run_result.error);
const run = run_result.ok ? run_result.value : null;
let run_package: PipelinePackage | null = null;

if (run) {
	// Authz cross-check: this run's package must belong to this project. Otherwise
	// 404 (not 403 — don't leak the existence of cross-project run ids).
	const packages_result = await client.pipelines.packages.list({ project_id: project.id });
	if (!packages_result.ok) return rethrow(packages_result.error);
	run_package = packages_result.value.find((pkg: PipelinePackage) => pkg.id === run.package_id) ?? null;
	const owns_run = packages_result.value.some((pkg: PipelinePackage) => pkg.id === run.package_id);
	if (!owns_run) return new Response(null, { status: 404, statusText: "Run not found" });
}

// External deploy mode (#155): resolve the package-derived GitHub link targets
// used for commit/workflow deep-links. Defensive parse — the raw JSON column
// is untrusted on read.
const pkg: PipelinePackage | null = run ? run_package : null;
const external_target = pkg && pkg.deploy_mode === "external" ? parse_external_target(pkg.external_target) : null;
const repo = external_target?.repo ?? github_repo_from_url(pkg?.repo_url) ?? null;
const commit_url = run && run.commit_sha && repo ? github_commit_url(repo, run.commit_sha) : null;

// Status vocab is a closed enum derived from the schema — a new RunStatus
// added to RUN_STATUSES makes this Record non-exhaustive and fails the
// typecheck, which is the point.
const ROLLBACK_ELIGIBLE: Record<RunStatus, boolean> = {
	queued: true,
	deploying: true,
	unconfirmed: true,
	baking: true,
	awaiting_approval: true,
	rolling_back: true,
	completed: false,
	rolled_back: false,
	failed: false,
	cancelled: false,
};
---

<PageLayout title={`Run ${run_id} - ${project_id}`}>
	<ProjectLayout project_id={project_id}>
		<div class="stack stack-md">
			<a href={`/project/${project_id}/pipeline`} style="text-decoration: none; color: var(--text-link); font-size: 0.9rem;">
				← back to pipeline
			</a>
			{run === null ? (
				<div data-testid="pipeline-degraded" role="alert" class="row row-sm" style="padding: 0.6rem 0.9rem; border: 1px solid var(--warning, var(--item-yellow)); background: var(--warning-bg, var(--bg-alt)); border-radius: var(--radius, 4px);">
					<span class="status-badge" style="padding: 0.15rem 0.6rem; border-radius: 0.25rem; font-size: 0.75rem; background: var(--warning-bg, var(--bg-alt)); color: var(--warning, var(--item-yellow)); border: 1px solid var(--warning, var(--item-yellow));">degraded</span>
					<span class="text-sm">Pipeline service unavailable — run {run_id} can't be loaded right now.</span>
				</div>
			) : (
				<>
				<h1 style="margin: 0;">{run.id.substring(0, 12)}</h1>
				<p class="text-sm text-faint" style="margin: 0;">
					Status: <strong>{run.status}</strong> · Shape: <strong>{run.shape}</strong>
				</p>

				{run.status === "unconfirmed" && (
					<div
						data-testid="run-unconfirmed"
						role="status"
						class="stack stack-sm"
						style="padding: 0.6rem 0.9rem; border: 1px solid var(--warning, var(--item-yellow)); background: var(--warning-bg, var(--bg-alt)); border-radius: var(--radius, 4px);"
					>
						<span class="text-sm" style="color: var(--warning, var(--item-yellow));">
							CI never reported back — outcome unknown. Check the workflow run, then wait for CI or cancel.
						</span>
						{external_target && (
							<a
								class="text-sm"
								href={github_workflow_url(external_target)}
								style="color: var(--text-link);"
							>
								Open the workflow run on GitHub ({external_target.repo} / {external_target.workflow})
							</a>
						)}
					</div>
				)}

				<div class="stack stack-lg">
					<div class="stack stack-md">
						<h2>stage progress</h2>
						<RunProgress client:load run={run} />
					</div>

					{run.current_stage && (
						<div class="stack stack-md">
							<h2>current stage gate</h2>
							<StageGate client:load run={run} external={external_target && { repo: external_target.repo, workflow: external_target.workflow }} />
						</div>
					)}

					{external_target && (
						<div class="stack stack-md">
							<h2>dispatches</h2>
							<DispatchStatusPanel client:load run_id={run.id} />
						</div>
					)}

					<div class="stack stack-md">
						<h2>stage events</h2>
						<StageEventTimeline client:visible run_id={run.id} />
					</div>

					<div class="stack stack-md">
						<div class="row row-between">
							<h2 style="margin: 0;">actions</h2>
						</div>
						<div class="row" style="gap: var(--space-sm); flex-wrap: wrap;">
							{ROLLBACK_ELIGIBLE[run.status] && (
								<RollbackButton
									client:load
									run_id={run.id}
									external={external_target && { repo: external_target.repo, workflow: external_target.workflow }}
								/>
							)}
						</div>
					</div>

					<div class="stack stack-md">
						<h2>run details</h2>
						<div class="card card-flat stack stack-sm">
							<div class="row row-sm">
								<span class="text-sm text-faint" style="min-width: 120px;">Run ID</span>
								<code style="font-family: monospace; color: var(--fg-muted);">{run.id}</code>
							</div>
							{run.version_set_id && (
								<div class="row row-sm" data-testid="run-version-set">
									<span class="text-sm text-faint" style="min-width: 120px;">Version Set</span>
									<code style="font-family: monospace; color: var(--fg-muted);">{run.version_set_id}</code>
								</div>
							)}
							{run.commit_sha && (
								<div class="row row-sm" data-testid="run-commit">
									<span class="text-sm text-faint" style="min-width: 120px;">Commit</span>
									{commit_url ? (
										<a href={commit_url} style="color: var(--text-link);">
											<code style="font-family: monospace;">{short_sha(run.commit_sha)}</code>
										</a>
									) : (
										<code style="font-family: monospace; color: var(--fg-muted);">{short_sha(run.commit_sha)}</code>
									)}
								</div>
							)}
							<div class="row row-sm">
								<span class="text-sm text-faint" style="min-width: 120px;">Rollout Shape</span>
								<span style="color: var(--fg);">{run.shape}</span>
							</div>
							{run.forced_atomic_reason && (
								<div class="row row-sm">
									<span class="text-sm text-faint" style="min-width: 120px;">Forced Atomic</span>
									<span style="color: var(--warning);">{run.forced_atomic_reason}</span>
								</div>
							)}
							{run.started_at && (
								<div class="row row-sm">
									<span class="text-sm text-faint" style="min-width: 120px;">Started</span>
									<span style="color: var(--fg-muted);">{new Date(run.started_at).toLocaleString()}</span>
								</div>
							)}
							{run.finished_at && (
								<div class="row row-sm">
									<span class="text-sm text-faint" style="min-width: 120px;">Finished</span>
									<span style="color: var(--fg-muted);">{new Date(run.finished_at).toLocaleString()}</span>
								</div>
							)}
						</div>
					</div>
				</div>
				</>
			)}
		</div>
	</ProjectLayout>
</PageLayout>
