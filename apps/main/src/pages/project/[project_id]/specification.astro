---
// v2.4 IA consolidation (task B1.4) — specification folded into docs (the
// docs tab renders this same editor plus the A4 doc list). Redirects rather
// than deletes: bookmarks, external links, and in-flight PRs referencing the
// old URL keep working.
const project_id = Astro.params.project_id!;
return Astro.redirect(`/project/${project_id}/docs${Astro.url.search}`, 301);
