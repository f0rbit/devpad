---
import type { PulseSummary } from "@devpad/api";
import CanvasSurface from "@/components/solid/canvas/canvas-surface";
import Outline from "@/components/solid/outline/outline";
import { ProjectContextSetter } from "@/components/solid/project-context-setter";
import PulseWidget from "@/components/solid/project/pulse-widget";
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { getProject } from "@/utils/api-client";
import { isMobileUserAgent } from "@/utils/is-mobile-user-agent";
import { loadOutline } from "@/utils/outline-data";

const project_id = Astro.params.project_id!;

const guard = await getProject(Astro);
if (guard instanceof Response) return guard;
const { client, project, user } = guard;

// P4.1 IA absorption: canvas is now the project home. `overview` and `work`
// no longer have their own routes/tabs (301s live in overview.astro /
// work.astro / canvas.astro). `work`'s outline is retained two ways:
// unconditionally on mobile (SSR-only, no canvas JS shipped — P4.3), and on
// desktop via an explicit `?view=list` toggle (the outline has interactions
// — rename, edge chips, milestone lens, zoom breadcrumbs — the canvas
// doesn't replicate; this is how "nothing uniquely shown is lost" holds
// without duplicating that surface inside the canvas).
const is_mobile = isMobileUserAgent(Astro.request.headers.get("user-agent"));
const CANVAS_VIEW_COOKIE = "canvas_view";
const view_param = Astro.url.searchParams.get("view");
const cookie_view = Astro.cookies.get(CANVAS_VIEW_COOKIE)?.value;
// `?view=` always wins over the cookie (an explicit link/bookmark shouldn't
// be silently overridden by a stale preference); with no `?view=` at all, a
// list-first user's last choice re-homes them straight to the outline
// instead of re-landing on canvas every visit.
const want_outline = is_mobile || (view_param ? view_param === "list" : cookie_view === "list");
// Only an EXPLICIT `?view=` choice updates the remembered preference — a bare
// `/project/:id` load (falling back to the cookie) must not re-write it.
if (!is_mobile && (view_param === "list" || view_param === "canvas")) {
	Astro.cookies.set(CANVAS_VIEW_COOKIE, view_param, { path: "/", maxAge: 60 * 60 * 24 * 365, sameSite: "lax" });
}

let outline_data: Awaited<ReturnType<typeof loadOutline>> | null = null;
let graph_result: Awaited<ReturnType<typeof client.projects.graph>> | null = null;

if (want_outline) {
	const zoom_id = Astro.url.searchParams.get("node");
	// A stale/foreign ?node= (deleted task, or one from another project) falls
	// back to the project root rather than 404ing the whole page.
	outline_data = (await loadOutline(client, project.id, zoom_id)) ?? (await loadOutline(client, project.id, null))!;
} else {
	graph_result = await client.projects.graph(project.id);
}
const initial_graph = graph_result?.ok ? graph_result.value : { tasks: [], links: [], rollups: {} };

// Best-effort pulse summary — page must render even if pulse is unreachable.
const pulse_result = await client.pulse.summary({ project_id: project.id, range: "7d" });
let pulse_summary: PulseSummary | null = null;
let pulse_error: string | null = null;
if (pulse_result.ok) {
	pulse_summary = pulse_result.value;
} else {
	const code = pulse_result.error?.code ?? "";
	const status = pulse_result.error?.status_code;
	pulse_error = code === "pulse_unreachable" || status === 503 ? "pulse_unreachable" : (pulse_result.error?.message ?? code ?? "pulse_error");
}
---

<PageLayout title={`${project_id} - devpad`}>
	<ProjectLayout project_id={project_id}>
		<ProjectContextSetter client:load id={project.id} name={project.project_id} />
		{
			!is_mobile && (
				// `@f0rbit/ui`'s `Tabs` is client-JS-only panel switching (DOM
				// discovery over `data-tab-value`, no `href`/navigation support) —
				// wrong tool for a control that swaps which SERVER-rendered surface
				// loads. This reuses the SAME a11y contract (`tablist`/`tab`/
				// `aria-selected`, arrow-key-navigable like a real tab strip) with
				// plain SSR `<a>`s instead, so it looks and keyboard-behaves like
				// tabs while still navigating.
				<div class="canvas-view-toggle" role="tablist" aria-label="Project view">
					<a href={`/project/${project_id}?view=canvas`} class="canvas-view-toggle-btn" role="tab" aria-selected={!want_outline}>
						canvas
					</a>
					<a href={`/project/${project_id}?view=list`} class="canvas-view-toggle-btn" role="tab" aria-selected={want_outline}>
						list
					</a>
				</div>
			)
		}
		{
			want_outline ? (
				<Outline client:load project={{ id: project.id, name: project.project_id }} ownerId={user.id} initial={outline_data!} />
			) : (
				<>
					<div class="canvas-home-hud">
						{project.description && <p class="canvas-home-description">{project.description}</p>}
						<p class="canvas-home-meta">
							<span>{project.status?.toLowerCase()}</span>
							<span>·</span>
							<span>{project.visibility?.toLowerCase()}</span>
							{project.repo_url && (
								<>
									<span>·</span>
									<a href={project.repo_url}>{project.repo_url}</a>
								</>
							)}
						</p>
					</div>
					<div class="canvas-home-surface">
						<CanvasSurface client:load projectId={project.id} projectName={project.project_id} initial={initial_graph} />
					</div>
					<PulseWidget projectSlug={project_id} summary={pulse_summary} error={pulse_error} client:visible />
				</>
			)
		}
	</ProjectLayout>
</PageLayout>
