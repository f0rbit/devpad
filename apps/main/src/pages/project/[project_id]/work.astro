---
// P4.1 IA absorption: `work` is no longer its own tab/route — the outline it
// showed is retained as the `?view=list` mode of the project home
// (`/project/:id`, see index.astro). Redirect rather than delete —
// bookmarks, external links, and in-flight PRs referencing the old URL keep
// working, including any `?node=` deep link into a zoomed subtree.
const project_id = Astro.params.project_id!;
const search = Astro.url.search;
const suffix = search ? `${search}&view=list` : "?view=list";
return Astro.redirect(`/project/${project_id}${suffix}`, 301);
---
