			"types": "./dist/database/media.d.ts",
			"import": "./dist/database/media.js"
		},
		"./database/types": {
			"source": "./src/database/types.ts",
			"types": "./dist/database/types.d.ts",
			"import": "./dist/database/types.js"
		},
		"./database/full-schema": {
			"source": "./src/database/full-schema.ts",
			"types": "./dist/database/full-schema.d.ts",
			"import": "./dist/database/full-schema.js"
		},
		"./rank": {
			"source": "./src/rank.ts",
			"types": "./dist/rank.d.ts",
			"import": "./dist/rank.js"
		},
		"./contracts": {
			"source": "./src/contracts/index.ts",
			"types": "./dist/contracts/index.d.ts",
			"import": "./dist/contracts/index.js"
		},
		"./blog": {
			"source": "./src/blog/index.ts",
			"types": "./dist/blog/index.d.ts",
			"import": "./dist/blog/index.js"
		},
		"./blog/types": {
			"source": "./src/blog/types.ts",
			"types": "./dist/blog/types.d.ts",
			"import": "./dist/blog/types.js"
		},
		"./blog/corpus": {
			"source": "./src/blog/corpus.ts",
			"types": "./dist/blog/corpus.d.ts",
			"import": "./dist/blog/corpus.js"
		},
		"./blog/corpus-shim": {
			"source": "./src/blog/corpus-shim.ts",
			"types": "./dist/blog/corpus-shim.d.ts",
			"import": "./dist/blog/corpus-shim.js"
		},
