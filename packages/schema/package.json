{
	"name": "@devpad/schema",
	"version": "2.0.0",
	"description": "Database schema, validation, and types for Devpad",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./database": {
			"source": "./src/database/index.ts",
			"types": "./dist/database/index.d.ts",
			"import": "./dist/database/index.js"
		},
		"./database/d1": {
			"source": "./src/database/d1.ts",
			"types": "./dist/database/d1.d.ts",
			"import": "./dist/database/d1.js"
		},
		"./database/bun": {
			"source": "./src/database/bun.ts",
			"types": "./dist/database/bun.d.ts",
			"import": "./dist/database/bun.js"
		},
		"./database/schema": {
			"source": "./src/database/schema.ts",
			"types": "./dist/database/schema.d.ts",
			"import": "./dist/database/schema.js"
		},
		"./database/blog": {
			"source": "./src/database/blog.ts",
