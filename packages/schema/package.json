			"source": "./src/media/platforms/reddit.ts",
			"types": "./dist/media/platforms/reddit.d.ts",
			"import": "./dist/media/platforms/reddit.js"
		},
		"./media/platforms/twitter": {
			"source": "./src/media/platforms/twitter.ts",
			"types": "./dist/media/platforms/twitter.d.ts",
			"import": "./dist/media/platforms/twitter.js"
		},
		"./pulse": {
			"source": "./src/pulse/index.ts",
			"types": "./dist/pulse/index.d.ts",
			"import": "./dist/pulse/index.js"
		},
		"./pipelines": {
			"source": "./src/pipelines/index.ts",
			"types": "./dist/pipelines/index.d.ts",
			"import": "./dist/pipelines/index.js"
		},
		"./bindings": {
			"source": "./src/bindings.ts",
			"types": "./dist/bindings.d.ts",
			"import": "./dist/bindings.js"
		},
		"./validation": {
			"source": "./src/validation.ts",
			"types": "./dist/validation.d.ts",
			"import": "./dist/validation.js"
		},
		"./types": {
			"source": "./src/types.ts",
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./errors": {
			"source": "./src/errors.ts",
			"types": "./dist/errors.d.ts",
			"import": "./dist/errors.js"
		}
	},
	"scripts": {
		"build": "tsc && cp -r src/database/drizzle dist/database/",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"generate": "bunx drizzle-kit generate"
	},
	"dependencies": {
		"@f0rbit/corpus": "^0.6.0",
		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "^0.7.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241205.0",
		"@types/node": "^20.11.24",
		"drizzle-kit": "^0.31.0",
		"typescript": "^5.3.3"
